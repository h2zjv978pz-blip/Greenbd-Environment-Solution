# Copy this file to .env.local and fill in your values
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here
JWT_SECRET=your-random-secret-key-here

# Optional — absolute path OUTSIDE the app's deploy folder where uploaded
# images/PDFs/audio should be stored. Set this on the live server (create the
# folder once via your host's file manager) so uploads survive redeploys —
# `next build` regenerates the whole .next directory (and the deploy folder
# itself may get refreshed from git), wiping anything stored inside it.
# UPLOADS_DIR=/home/your-username/persistent_uploads
